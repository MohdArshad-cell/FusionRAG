# App Settings
APP_NAME=FusionRAG
APP_ENV=development
DEBUG=true

# Embedding & Re-Ranking Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval & Fusion Parameters
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FUSION_TOP_N=10
FINAL_TOP_N=5

# Storage
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=fusionrag_docs
BM25_PERSIST_DIR=./data/bm25_index

# LLM Provider Configuration ("groq", "gemini", or "mock")
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

